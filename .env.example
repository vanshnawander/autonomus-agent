# Copy to .env and fill in. Never commit the real .env.

# --- LLM controller (OpenAI-compatible; default points at OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional overrides (defaults shown):
# DEVIN_ORCH_LLM_BASE_URL=https://openrouter.ai/api/v1
# DEVIN_ORCH_LLM_MODEL=stealth/ox-alpha
# DEVIN_ORCH_LLM_TEMP=0.2
# DEVIN_ORCH_LLM_MAX_TOKENS=0  # 0 = provider/model default (no orchestrator cap)

# Interactive Normal mode exposes commands/edits to the PTY controller.
# DEVIN_ORCH_DEVIN_MODEL=glm-5.2
# DEVIN_ORCH_DEVIN_EXTRA_ARGS=--respect-workspace-trust false
# DEVIN_ORCH_EXPORT_TRACES=true

# --- Workspace, mandatory local search, and optional restricted remote compute ---
# DEVIN_ORCH_WORKSPACE_ROOT=/absolute/path/to/autonomus-agent/runs
# SEARXNG_URL=http://127.0.0.1:8080
# DEVIN_ORCH_SERVERS_FILE=/absolute/path/to/autonomus-agent/servers.json
