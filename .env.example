# Copy to .env and fill in. Never commit the real .env.

# --- LLM controller (OpenAI-compatible; default points at OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional overrides (defaults shown):
# DEVIN_ORCH_LLM_BASE_URL=https://openrouter.ai/api/v1
# DEVIN_ORCH_LLM_MODEL=z-ai/glm-5.3-flash
# DEVIN_ORCH_LLM_TEMP=0.2
# DEVIN_ORCH_LLM_MAX_TOKENS=0  # 0 = provider/model default (no orchestrator cap)

# --- Agent CLI (see docs/AGENT_PLUGINS.md) ---
# Default CLI for every agent: devin | opencode | codex | claude-code.
# Sessions and individual agents can override it from the UI or API.
# DEVIN_ORCH_AGENT_CLI=devin
# Per-CLI overrides: DEVIN_ORCH_<CLI>_COMMAND / _MODEL / _EXTRA_ARGS
# DEVIN_ORCH_CLAUDE_CODE_MODEL=opus
# DEVIN_ORCH_CODEX_MODEL=gpt-5-codex
# DEVIN_ORCH_OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# Third-party adapters: comma-separated module:Class list.
# DEVIN_ORCH_AGENT_PLUGINS=my_plugins.aider:AiderAdapter

# Devin: interactive Normal mode exposes commands/edits to the PTY controller.
# DEVIN_ORCH_DEVIN_MODEL=swe-2-high
# DEVIN_ORCH_DEVIN_EXTRA_ARGS=--respect-workspace-trust false
# DEVIN_ORCH_EXPORT_TRACES=true

# --- Workspace, mandatory local search, and optional restricted remote compute ---
# DEVIN_ORCH_WORKSPACE_ROOT=/absolute/path/to/autonomus-agent/runs
# SEARXNG_URL=http://127.0.0.1:8080
# DEVIN_ORCH_SERVERS_FILE=/absolute/path/to/autonomus-agent/servers.json
